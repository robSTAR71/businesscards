{
  "expo": {
    "name": "businesscards",
    "slug": "businesscards",
    "version": "1.0.0",
    "scheme": "businesscards",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Diese App benötigt Kamerazugriff, um Visitenkarten zu fotografieren."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Diese App benötigt Zugriff auf deine Fotos, um Visitenkarten aus der Galerie zu importieren."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Diese App benötigt Zugriff auf deine Kontakte, um gescannte Visitenkarten dort zu speichern."
        }
      ]
    ]
  }
}
