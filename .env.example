# URL des deployten OCR-Workers (siehe server/ocr-worker/README.md).
# Ohne diese Variable funktioniert die App weiterhin: QR-Codes werden weiter erkannt,
# und Kontakte können manuell im Review-Screen eingetragen werden.
EXPO_PUBLIC_OCR_ENDPOINT=https://businesscards-ocr-worker.<dein-account>.workers.dev

# Google-OAuth-Client-ID für den "Speichern & zu Google Contacts"-Button (siehe README).
# Ohne diese Variable funktioniert die App weiterhin, nur der Google-Sync-Button meldet
# "nicht konfiguriert".
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=<deine-google-oauth-client-id>.apps.googleusercontent.com
